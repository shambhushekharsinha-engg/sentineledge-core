<mujoco model="bimanual_dinner_table">
    <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
    <option timestep="0.002" iterations="50" tolerance="1e-4" gravity="0 0 -9.81"/>

    <include file="objects.xml"/>

    <visual>
        <map force="0.1" zfar="30"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global offwidth="1920" offheight="1080" elevation="-20" azimuth="120"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
        <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
        <material name="table_mat" rgba="0.6 0.4 0.2 1" specular="0.1"/>
        <material name="cabinet_mat" rgba="0.4 0.25 0.15 1" specular="0.2"/>
    </asset>

    <worldbody>
        <light name="main_light" directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="0 0 1" pos="0 0 0" material="matplane" condim="3"/>

        <!-- Main Camera -->
        <camera name="main_cam" pos="0 -1.5 1.5" xyaxes="1 0 0 0 1 1" mode="targetbody" target="table"/>

        <!-- The Dinner Table -->
        <body name="table" pos="0 0 0.75">
            <geom name="table_top" type="box" size="0.6 0.4 0.02" material="table_mat" friction="1 0.005 0.0001"/>
            <geom type="cylinder" size="0.02 0.375" pos="0.55 0.35 -0.375" material="table_mat"/>
            <geom type="cylinder" size="0.02 0.375" pos="-0.55 0.35 -0.375" material="table_mat"/>
            <geom type="cylinder" size="0.02 0.375" pos="0.55 -0.35 -0.375" material="table_mat"/>
            <geom type="cylinder" size="0.02 0.375" pos="-0.55 -0.35 -0.375" material="table_mat"/>
        </body>

        <!-- Cabinet and Drawer (For Target Scenario: "Open a drawer") -->
        <body name="cabinet" pos="0 0.3 0.95">
            <geom name="cabinet_body" type="box" size="0.2 0.1 0.2" material="cabinet_mat"/>
            <!-- Sliding Drawer -->
            <body name="drawer" pos="0 -0.1 0">
                <joint name="drawer_slide" type="slide" axis="0 1 0" range="0 0.15" damping="1.0"/>
                <geom name="drawer_front" type="box" size="0.18 0.02 0.08" rgba="0.5 0.3 0.1 1"/>
                <geom name="drawer_handle" type="cylinder" size="0.01 0.05" pos="0 -0.02 0" xyaxes="1 0 0 0 0 1" rgba="0.8 0.8 0.8 1"/>
            </body>
        </body>

        <!-- Placeholder attachment points for the arms -->
        <body name="arm_left_base" pos="-0.4 -0.2 0.77">
            <geom type="cylinder" size="0.05 0.01" rgba="1 0 0 1"/>
        </body>

        <body name="arm_right_base" pos="0.4 -0.2 0.77">
            <geom type="cylinder" size="0.05 0.01" rgba="0 1 0 1"/>
        </body>

        <!-- Dynamic Obstacle for Collision Avoidance Testing -->
        <body name="dynamic_obstacle" pos="0 0.1 0.82">
            <joint name="obstacle_slide" type="slide" axis="1 0 0" damping="0.1"/>
            <geom name="obstacle_geom" type="sphere" size="0.04" rgba="1 0.2 0 1" mass="0.5"/>
        </body>
    </worldbody>
</mujoco>
